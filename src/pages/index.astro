---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Img from "@/components/Media/Img.astro";
import lumos_background from "@/assets/graphics/lumos-background.svg";
import Icon from "@/components/Media/Icon.astro";
import logo_icon from "@/assets/logo/logo-icon.svg";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Slider from '@/components/Interactive/Slider.astro';
import Tabs from '@/components/Interactive/Tabs.astro';
import Accordion from '@/components/Interactive/Accordion.astro';
import AccordionItem from '@/components/Interactive/AccordionItem.astro';
---

<Layout theme="dark" description="df" title="dsfdfsdf">
  <Section
    paddingBottom="even"
    containerClass="flex-grow"
    paddingTop="even"
    class="flex-grow"
    style="min-height: calc(100svh - var(--nav-height));"
  >
    <ContentWrapper
      class="flex-grow theme-brand"
      variant="card"
      mediaOpacity={100}
    >
      <Icon src={logo_icon} variant="large" />
      <Heading variant="display" tag="h1" class="margin-block-8"
        >Style Guide</Heading
      >
      <Eyebrow variant="tag">v0.0.3</Eyebrow>
      <Img
        slot="column2"
        src={lumos_background}
        width={1920}
        height={1080}
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>
  <Section>
    <ContentWrapper variant="columns" column1Class="align-self-start">
      <Heading maxWidth={12}>Pytania i odpowidzi</Heading>
      <Slider>
        <Tabs>
          <Img />
        </Tabs>
        <Tabs />
        <Tabs></Tabs>
      </Slider>
      <Accordion preview={true} slot="column2">
        <AccordionItem open={true} headingTag="h5" heading="Pytanie 1">Odpowiedźdsa fas aasdfadf adfdas fasdfasd fasdf asdfasd ads fsda fasdf asdfa sad asdfas dsaf asdf ds as dfsa sd fdas fasdf asd fasd fas fasf asfafaasd fads asdfas asd fadsd fdasfadsasdf asdf afsdsfd afsd</AccordionItem>
        <AccordionItem open={true} headingTag="h5" heading="Pytanie 2">Odpowiedź</AccordionItem>
        <AccordionItem open={true} headingTag="h5" heading="Pytanie">Odpowiedź</AccordionItem>
        <AccordionItem open={true} headingTag="h5" heading="Pytanie">Odpowiedź</AccordionItem>
      </Accordion>
    </ContentWrapper>
  </Section>
</Layout>
